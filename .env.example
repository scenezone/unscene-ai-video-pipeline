# Configuration template: copy to .env and edit .env for your machine.
# Both startup modes load .env; they do not load .env.example directly.
# Keep real credentials in .env. Leave credentials blank in this template.

# Unscene two-stage worker: python -m services.unscene_worker
# The Unscene platform must be running and have jobs queued for processing.
# Obtain these credentials from Unscene Admin -> AI clients.
# They are separate from the HTTP Basic clients created by the local API.
# The worker obtains OAuth tokens and signs requests using these credentials.
# No separate access-token or HMAC-secret environment variable is required.
# Base URL must end in /ai/v1. HTTP is allowed only for loopback development.
# For a remote platform, use its actual HTTPS URL, e.g. https://platform.example.com/ai/v1.
UNSCENE_BASE_URL=http://localhost:4380/ai/v1
UNSCENE_CLIENT_ID=
UNSCENE_CLIENT_SECRET=
# Set a unique ID per running worker; defaults to hostname + process ID.
# UNSCENE_WORKER_ID=gpu-box-1
UNSCENE_STEPS=DETECT_TYPES,MATCH
# Heartbeat: 30-60 seconds. Idle claim polling: 2-5 seconds.
UNSCENE_HEARTBEAT_SECONDS=45
UNSCENE_POLL_SECONDS=3
# The following inference and transfer settings apply to the Unscene worker.
AI_TARGET_FPS=1
# Require 0 <= similarity threshold <= single-candidate threshold <= 1.
AI_SIMILARITY_THRESHOLD=0.55
AI_SINGLE_CANDIDATE_THRESHOLD=0.70
AI_MIN_MARGIN=0.05
AI_MIN_MASK_AREA_RATIO=0.20
AI_DETECTOR_VERSION=groundingdino-types-1
AI_MATCHER_VERSION=dino-sam-clip-1
AI_WORK_DIR=data/unscene
# Download limits in bytes: video 20 GiB, image 30 MiB, manifest 20 MiB.
AI_MAX_VIDEO_BYTES=21474836480
AI_MAX_IMAGE_BYTES=31457280
AI_MAX_MANIFEST_BYTES=20971520

# Local API: python main.py OR uvicorn main:app --host 0.0.0.0 --port 8000
# These API/database settings are not used by the separate Unscene worker.
# Protected routes use HTTP Basic: client ID as username, secret as password.
# On startup, if no active client exists, the API creates one and prints its secret once.
# Clients are stored in AI_AUTH_DB; no local API client ID/secret .env fields are needed.
# Additional clients: python -m services.auth_admin create --name "Partner name"
AI_AUTH_DB=data/auth/auth.sqlite3
AI_JOB_DB=data/jobs/jobs.sqlite3
# Host/port below apply to python main.py. For uvicorn, pass --host and --port.
AI_API_HOST=0.0.0.0
AI_API_PORT=8000
# Optional Ollama address for the local API's older prompt-generation pipeline.
# The Unscene two-stage worker does not use Ollama.
# OLLAMA_HOST=http://127.0.0.1:11434
# Local API item descriptions (colour, pattern, material...) on every detected range.
# Uses an Ollama vision model; if it is unavailable, jobs still finish without descriptions.
# Install once: ollama pull qwen3-vl:4b-instruct
# AI_DESCRIBE_ITEMS=true
# AI_DESCRIBE_MODEL=qwen3-vl:4b-instruct

# Shared output override: used by both the local API and the Unscene worker.
# If omitted, defaults are outputs/jobs (API) and outputs/unscene (worker).
AI_OUTPUT_DIR=outputs/unscene
# Used by the Unscene worker's logging setup.
LOG_LEVEL=INFO
