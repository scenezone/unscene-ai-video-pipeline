# Secrets: provide real settings to the container at runtime.
.env
.env.*
!.env.example

# Version control and editor files
.git/
.gitignore
.vscode/
.idea/

# Python environments and generated files
venv/
.venv/
env/
__pycache__/
**/__pycache__/
*.py[cod]
*.pyd
*.egg-info/
build/
dist/

# Local runtime files; the app creates these directories as needed.
data/
outputs/
tmp/
logs/
*.log
*.sqlite
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal

# Local caches and tool state
.cache/
**/.cache/
.huggingface/
huggingface_cache/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.codex_pdf_tools/
.pdf_review_tools/

# Tests and local-only files are not required by the production image.
tests/
Untitled-*.ps1

# Documentation is available in the repository; omit it from the image.
README.md
readme.md
docs/

# Include the model code/config and the two checkpoints required at runtime.
# Ignore other weight folders to avoid copying unrelated models.
weights/*
!weights/GroundingDINO/
!weights/GroundingDINO/**
!weights/sam-weight/
!weights/sam-weight/**

# Prune non-runtime files from the vendored GroundingDINO source.
weights/GroundingDINO/.git/
weights/GroundingDINO/demo/
weights/GroundingDINO/outputs/
weights/GroundingDINO/*.ipynb
weights/GroundingDINO/test*
weights/GroundingDINO/.asset/
